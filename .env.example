# Postgres container
POSTGRES_DB=farm
POSTGRES_USER=farm
POSTGRES_PASSWORD=farm_password

# RabbitMQ container
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# .NET services (Section__Key overrides appsettings.json)
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=farm;Username=farm;Password=farm_password
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__Username=guest
RabbitMq__Password=guest
RabbitMq__PrefetchCount=10
Messaging__DlqReprocess__IntervalMinutes=5
Collector__IntervalSeconds=60
