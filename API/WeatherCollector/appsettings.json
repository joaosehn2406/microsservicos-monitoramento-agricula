{
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "Exchange": "farm.events",
    "ReconnectDelaySeconds": 5
  },
  "Collector": {
    "IntervalSeconds": 60
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com",
    "TimeoutSeconds": 10,
    "Limits": {
      "RequestsPerMinute": 600,
      "RequestsPerHour": 5000,
      "RequestsPerDay": 10000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
